{
  "name": "csv2tab-app",
  "version": "0.3.0",
  "private": true,
  "author": "Bojan",
  "type": "module",
  "description": "Desktop verzija csv2tab (Electron, Windows i Linux): CSV / ODS / XLSX krojne liste u WT Input .tab.",
  "scripts": {
    "web:install": "npm --prefix web ci",
    "web:build": "npm --prefix web run build",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node scripts/electron.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "main": "dist/main/index.js"
}
