{
  "name": "csv2tab-app",
  "version": "0.8.1",
  "private": true,
  "author": "Bojan",
  "type": "module",
  "description": "Desktop verzija csv2tab (Electron, Windows i Linux): CSV / ODS / XLSX krojne liste u WT Input .tab.",
  "scripts": {
    "web:install": "npm --prefix web ci",
    "web:build": "npm --prefix web run build",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node scripts/electron.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "icons": "node scripts/icons.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "build:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "build:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:package": "node tests/package-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "main": "dist/main/index.js",
  "desktopName": "csv2tab-app.desktop"
}
